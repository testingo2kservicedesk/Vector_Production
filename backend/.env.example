DEBUG=false
HOST=0.0.0.0
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY_HOURS=8
CORS_ORIGINS=https://app.example.com
FIREBASE_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
PASSWORD_RESET_SECRET=replace-with-a-separate-long-random-secret
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
MAIL_PROVIDER=microsoft_graph
MICROSOFT_TENANT_ID=your-microsoft-entra-tenant-id
MICROSOFT_CLIENT_ID=your-entra-app-client-id
MICROSOFT_CLIENT_SECRET=store-this-in-secret-manager
MICROSOFT_SENDER_EMAIL=your-mailbox@yourdomain.com
